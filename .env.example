# ---------------------------------------------------------------------------
# InfoAI.LK environment variables
# Copy to `.env.local` for local dev, and set the same in Vercel Project Settings.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — must NEVER be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the Supabase Storage bucket that holds uploaded official documents.
SUPABASE_DOCUMENTS_BUCKET=documents

# --- Google Gemini ---------------------------------------------------------
# Server-only API key. Never exposed to the browser.
GEMINI_API_KEY=your-gemini-api-key

# Model names change — verify current names at https://ai.google.dev/gemini-api/docs
# Answering (Flash tier). Examples: gemini-2.5-flash, gemini-flash-latest
GEMINI_ANSWER_MODEL=gemini-2.5-flash

# Embeddings. gemini-embedding-001 is MRL-truncatable to 768/1536/3072.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding output dimensionality. MUST match the pgvector column dimension in
# supabase/migrations/0001_init.sql (vector(<dim>)). If you change this, update
# the migration and re-embed all published procedures.
GEMINI_EMBEDDING_DIM=768

# --- RAG tuning ------------------------------------------------------------
# Number of chunks to retrieve.
RAG_TOP_K=6
# Cosine-similarity threshold [0..1]; below this the "no information" fallback fires.
RAG_MATCH_THRESHOLD=0.6
